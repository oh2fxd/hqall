# Server configuration
HQALL_HOST=0.0.0.0
HQALL_PORT=8077

# Optional: set this to enable GitHub update checks (e.g. owner/repo)
HQALL_REPO=oh2fxd/hqall

# Optional upstream credentials (HQALL runs 100% keyless by default for all core layers)
# AISHub vessel tracking key (sign up free at https://www.aishub.net/)
AIS_API_KEY=

# APRS-IS verified callsign & passcode (sign up / verify at https://aprs.fi)
APRS_CALLSIGN=
APRS_PASSCODE=

# aprs.fi JSON API fallback key (get key at https://aprs.fi/page/api)
APRS_API_KEY=

# Optional User-Agent contact string
HQALL_CONTACT=local
